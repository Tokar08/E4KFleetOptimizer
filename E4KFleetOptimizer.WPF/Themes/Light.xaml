<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F3F4F6"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#4aa86a"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9acaba"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FEE2E2"/>
</ResourceDictionary>
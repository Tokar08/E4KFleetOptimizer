<Window x:Class="E4KFleetOptimizer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:E4KFleetOptimizer.WPF"
        mc:Ignorable="d"
        Title="E4K Fleet Optimizer - Управление кораблями" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="PreviewTextInput" Handler="NumberValidationTextBox"/>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <Border BorderBrush="#FF4B4B" BorderThickness="2" CornerRadius="2">
                                <AdornedElementPlaceholder x:Name="customAdorner"/>
                            </Border>
                            <TextBlock Text="{Binding [0].ErrorContent}" 
                                       Foreground="#FF4B4B" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="#3F1D1D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">

            <GroupBox Header="Глобальные параметры" Padding="10">
                <StackPanel>
                    <TextBlock Text="Макс. слотов на островах:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding MaxIslandSlots, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Добавить корабли в замок" Margin="0,15,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Уровень:" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailableLevels}" 
                              SelectedItem="{Binding SelectedLevel}" 
                              Margin="0,5,0,15"/>

                    <TextBlock Text="Количество:" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,15" HorizontalAlignment="Center">
                        <Button Content="-10" Style="{StaticResource CircleButtonStyle}" Command="{Binding ChangeShipsCountCommand}" CommandParameter="-10" Margin="0,0,5,0"/>
                        <Button Content="-1" Style="{StaticResource CircleButtonStyle}" Command="{Binding ChangeShipsCountCommand}" CommandParameter="-1"/>
                        <TextBox Text="{Binding ShipsToAddCount, UpdateSourceTrigger=PropertyChanged}" Width="60" TextAlignment="Center" Margin="5,0" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        <Button Content="+1" Style="{StaticResource CircleButtonStyle}" Command="{Binding ChangeShipsCountCommand}" CommandParameter="1"/>
                        <Button Content="+10" Style="{StaticResource CircleButtonStyle}" Command="{Binding ChangeShipsCountCommand}" CommandParameter="10" Margin="5,0,0,0"/>
                    </StackPanel>

                    <Button Content="ДОБАВИТЬ В ЗАМОК" Command="{Binding AddToFleetCommand}" Height="30" FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Корабли в замке" Margin="0,15,0,0" Padding="5" Height="220">
                <ListBox ItemsSource="{Binding CurrentFleet}" HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14">
                                    <Run Text="Уровень: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Level, Mode=OneWay}"/>
                                    <Run Text="   |   Кол-во: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Count, Mode=OneWay}"/>
                                </TextBlock>

                                <Button Grid.Column="1" Content="Удалить" 
                                        Command="{Binding DataContext.RemoveFromFleetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                        CommandParameter="{Binding}" 
                                        Padding="10,2" Background="Transparent" Foreground="#F87171"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </StackPanel>

        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10">
                <TabItem Header="Оптимизация по бюджету">
                    <StackPanel Margin="15">
                        <TextBlock Text="Доступный бюджет (аквамарин):" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,20" FontSize="14"/>

                        <Button Content="РАССЧИТАТЬ ПО БЮДЖЕТУ" 
                                Command="{Binding CalculateByBudgetCommand}" 
                                Height="40" FontSize="14" FontWeight="Bold"/>

                        <Border Margin="0,20,0,0" Padding="15" CornerRadius="5" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BudgetResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="ИТОГИ РАСПРЕДЕЛЕНИЯ БЮДЖЕТА" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                <TextBlock FontSize="15" Margin="0,0,0,5">
                                    <Run Text="Потрачено аквамарина: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.TotalSpent}" FontWeight="Bold" Foreground="#F87171"/>
                                    <Run Text=" акв."/>
                                </TextBlock>
                                <TextBlock FontSize="15" Margin="0,0,0,5">
                                    <Run Text="Остаток бюджета: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.RemainingBudget}" FontWeight="Bold"/>
                                    <Run Text=" акв."/>
                                </TextBlock>
                                <TextBlock FontSize="15">
                                    <Run Text="Максимальный прирост очков: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.TotalPointsGained}" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Достижение цели">
                    <StackPanel Margin="15">
                        <TextBlock Text="Целевые грузовые очки:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TargetPoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,20" FontSize="14"/>

                        <Button Content="РАССЧИТАТЬ ДЛЯ ЦЕЛИ" 
                                Command="{Binding CalculateByTargetCommand}" 
                                Height="40" FontSize="14" FontWeight="Bold"/>

                        <Border Margin="0,20,0,0" Padding="15" CornerRadius="5" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="ИТОГИ ДОСТИЖЕНИЯ ЦЕЛИ" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Необходимо аквамарина: " FontWeight="Bold"/>
                                    <Run Text="{Binding TargetResult.TotalSpent}" FontWeight="Bold" FontSize="20" Foreground="#F87171"/>
                                    <Run Text=" акв." FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="15">
                                    <Run Text="Итоговый прирост очков: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding TargetResult.TotalPointsGained}" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <ToggleButton Grid.Row="0" 
              IsChecked="{Binding IsDarkTheme}"
              HorizontalAlignment="Right" 
              VerticalAlignment="Top" 
              Margin="0,2,10,0"
              Background="Transparent"
              BorderThickness="0"
              Cursor="Hand">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons" Foreground="#FFFF57" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="5">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons" Foreground="#576DFF" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            
            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" 
                       Foreground="#F87171" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <GroupBox Grid.Row="2" Header="Детализация улучшений" Margin="0,5,0,0">
                <GroupBox.Style>
                    <Style TargetType="GroupBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveResult}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <ItemsControl ItemsSource="{Binding ActiveResult.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                                    <Run Text="{Binding ShipsCount}"/>
                                                    <Run Text=" шт. | Ур. "/>
                                                    <Run Text="{Binding FromLevel}"/>
                                                    <Run Text=" ➔ "/>
                                                    <Run Text="{Binding ToLevel}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                                                    <Run Text="Прирост грузовых очков: "/>
                                                    <Run Text="{Binding TotalPointsGained}" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#F87171">
                                                <Run Text="- "/>
                                                <Run Text="{Binding TotalCost}"/>
                                                <Run Text=" акв."/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
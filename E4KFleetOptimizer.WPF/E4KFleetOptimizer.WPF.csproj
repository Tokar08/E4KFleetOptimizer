<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\ICO\Aqua ico.ico" />
    <None Remove="Resources\PNG\icon_aqua.png" />
    <None Remove="Resources\PNG\icon_cargo.png" />
    <None Remove="Resources\PNG\icon_island.png" />
    <None Remove="Resources\PNG\icon_level.png" />
    <None Remove="Resources\PNG\icon_logo.png" />
    <None Remove="Resources\PNG\icon_ship.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\E4KFleetOptimizer.Core\E4KFleetOptimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\ICO\Aqua ico.ico" />
    <Resource Include="Resources\PNG\icon_aqua.png" />
    <Resource Include="Resources\PNG\icon_cargo.png" />
    <Resource Include="Resources\PNG\icon_island.png" />
    <Resource Include="Resources\PNG\icon_level.png" />
    <Resource Include="Resources\PNG\icon_logo.png" />
    <Resource Include="Resources\PNG\icon_ship.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\ShipDataTable.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ships.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

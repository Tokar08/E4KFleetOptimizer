<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#111827"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#4aa86a"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9acaba"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#7F1D1D"/>
</ResourceDictionary>
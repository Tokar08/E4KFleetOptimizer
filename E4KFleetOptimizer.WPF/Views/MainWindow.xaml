<Window x:Class="E4KFleetOptimizer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:E4KFleetOptimizer.WPF"
        mc:Ignorable="d"
        Title="E4K Fleet Optimizer - Управление кораблями" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">

            <GroupBox Header="Глобальные параметры" Padding="10">
                <StackPanel>
                    <TextBlock Text="Макс. слотов на островах:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding MaxIslandSlots, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5" Padding="2"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Добавить корабли в замок" Margin="0,15,0,0" Padding="10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Уровень:" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AvailableLevels}" 
                                      SelectedItem="{Binding SelectedLevel}" 
                                      Margin="0,5,0,15" Padding="2"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Количество:" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15" HorizontalAlignment="Center">
                                <Button Content=" - " Command="{Binding ChangeShipsCountCommand}" CommandParameter="-1" Width="30" FontWeight="Bold"/>
                                <TextBox Text="{Binding ShipsToAddCount, UpdateSourceTrigger=PropertyChanged}" Width="50" TextAlignment="Center" Margin="5,0" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                <Button Content=" + " Command="{Binding ChangeShipsCountCommand}" CommandParameter="1" Width="30" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Button Content="ДОБАВИТЬ В ЗАМОК" Command="{Binding AddToFleetCommand}" Height="30" FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Корабли в замке" Margin="0,15,0,0" Padding="5" Height="220">
                <ListBox ItemsSource="{Binding CurrentFleet}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14">
                                    <Run Text="Уровень: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Level, Mode=OneWay}"/>
                                    <Run Text="   |   Кол-во: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Count, Mode=OneWay}"/>
                                </TextBlock>

                                <Button Grid.Column="1" Content="Удалить" 
                                        Command="{Binding DataContext.RemoveFromFleetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                        CommandParameter="{Binding}" 
                                        Padding="10,2" Foreground="DarkRed"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

           <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10">

                <TabItem Header="Оптимизация по бюджету">
                    <StackPanel Margin="15">
                        <TextBlock Text="Доступный бюджет (аквамарин):" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="4" FontSize="14"/>

                        <Button Content="РАССЧИТАТЬ ПО БЮДЖЕТУ" 
                                Command="{Binding CalculateByBudgetCommand}" 
                                Height="40" FontSize="14" FontWeight="Bold" Background="#FF3D70B2" Foreground="White"/>
                        
                        <Border Margin="0,20,0,0" Padding="15" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0F8FF"/>
                                    <Setter Property="BorderBrush" Value="#87CEFA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BudgetResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="ИТОГИ РАСПРЕДЕЛЕНИЯ БЮДЖЕТА" FontWeight="Bold" FontSize="15" Foreground="#1A3B66" Margin="0,0,0,10"/>
                                <TextBlock FontSize="15" Margin="0,0,0,5">
                                    <Run Text="Потрачено аквамарина: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.TotalSpent}" FontWeight="Bold" Foreground="#B23D3D"/>
                                    <Run Text=" акв."/>
                                </TextBlock>
                                <TextBlock FontSize="15" Margin="0,0,0,5">
                                    <Run Text="Остаток бюджета: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.RemainingBudget}" FontWeight="Bold"/>
                                    <Run Text=" акв."/>
                                </TextBlock>
                                <TextBlock FontSize="15">
                                    <Run Text="Максимальный прирост очков: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.TotalPointsGained}" FontWeight="Bold" Foreground="DarkGreen"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Достижение цели">
                    <StackPanel Margin="15">
                        <TextBlock Text="Целевые грузовые очки:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TargetPoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="4" FontSize="14"/>

                        <Button Content="РАССЧИТАТЬ ДЛЯ ЦЕЛИ" 
                                Command="{Binding CalculateByTargetCommand}" 
                                Height="40" FontSize="14" FontWeight="Bold" Background="#FF2E8B57" Foreground="White"/>

                        <Border Margin="0,20,0,0" Padding="15" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0FFF0"/>
                                    <Setter Property="BorderBrush" Value="#8FBC8F"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="ИТОГИ ДОСТИЖЕНИЯ ЦЕЛИ" FontWeight="Bold" FontSize="15" Foreground="#164A2D" Margin="0,0,0,10"/>
                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Необходимо аквамарина: " FontWeight="Bold"/>
                                    <Run Text="{Binding TargetResult.TotalSpent}" FontWeight="Bold" FontSize="20" Foreground="#D13438"/>
                                    <Run Text=" акв." FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="15">
                                    <Run Text="Итоговый прирост очков: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding TargetResult.TotalPointsGained}" FontWeight="Bold" Foreground="DarkGreen"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" 
                       Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            
            <GroupBox Grid.Row="2" Header="Детализация улучшений" Margin="0,5,0,0">
                <GroupBox.Style>
                    <Style TargetType="GroupBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveResult}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <ItemsControl ItemsSource="{Binding ActiveResult.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                                    <Run Text="{Binding ShipsCount}"/>
                                                    <Run Text=" шт. | Ур. "/>
                                                    <Run Text="{Binding FromLevel}"/>
                                                    <Run Text=" ➔ "/>
                                                    <Run Text="{Binding ToLevel}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#666666" Margin="0,2,0,0">
                                                    <Run Text="Прирост грузовых очков: "/>
                                                    <Run Text="{Binding TotalPointsGained}" FontWeight="Bold" Foreground="DarkGreen"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#B23D3D">
                                                <Run Text="- "/>
                                                <Run Text="{Binding TotalCost}"/>
                                                <Run Text=" акв."/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
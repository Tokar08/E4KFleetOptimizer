<Window x:Class="E4KFleetOptimizer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:E4KFleetOptimizer.WPF"
        mc:Ignorable="d"
        Title="E4K Fleet Optimizer - Управление кораблями" Height="650" Width="1050"
        Icon="/Resources/ICO/Aqua ico.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="PreviewTextInput" Handler="NumberValidationTextBox"/>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <Border BorderBrush="#FF4B4B" BorderThickness="2" CornerRadius="2">
                                <AdornedElementPlaceholder x:Name="customAdorner"/>
                            </Border>
                            <TextBlock Text="{Binding [0].ErrorContent}" 
                                       Foreground="#FF4B4B" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="#3F1D1D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">

            <GroupBox Header="Глобальные параметры" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Image Source="/Resources/PNG/icon_island.png" Width="20" Height="20" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Макс. слотов на островах:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Text="{Binding MaxIslandSlots, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Добавить корабли в замок" Margin="0,15,0,0" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Image Source="/Resources/PNG/icon_level.png" Width="20" Height="20" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Уровень:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding AvailableLevels}" 
                              SelectedItem="{Binding SelectedLevel}" 
                              Margin="0,5,0,15"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <Image Source="/Resources/PNG/icon_ship.png" Width="20" Height="20" Margin="0,2,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Количество:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,15" HorizontalAlignment="Center">
                        <Button Content="-10" Style="{StaticResource CircleButtonStyle}" Command="{Binding ChangeShipsCountCommand}" CommandParameter="-10" Margin="0,0,5,0"/>
                        <Button Content="-1" Style="{StaticResource CircleButtonStyle}" Command="{Binding ChangeShipsCountCommand}" CommandParameter="-1"/>
                        <TextBox Text="{Binding ShipsToAddCount, UpdateSourceTrigger=PropertyChanged}" Width="60" TextAlignment="Center" Margin="5,0" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        <Button Content="+1" Style="{StaticResource CircleButtonStyle}" Command="{Binding ChangeShipsCountCommand}" CommandParameter="1"/>
                        <Button Content="+10" Style="{StaticResource CircleButtonStyle}" Command="{Binding ChangeShipsCountCommand}" CommandParameter="10" Margin="5,0,0,0"/>
                    </StackPanel>

                    <Button Content="ДОБАВИТЬ В ЗАМОК" Command="{Binding AddToFleetCommand}" Height="30" FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Корабли в замке" Margin="0,15,0,0" Padding="5" Height="220">
                <ListBox ItemsSource="{Binding CurrentFleet}" HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14">
                                    <Run Text="Уровень: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Level, Mode=OneWay}"/>
                                    <Run Text="   |   Кол-во: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Count, Mode=OneWay}"/>
                                </TextBlock>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DeleteIconButtonStyle}" 
                                        Command="{Binding DataContext.RemoveFromFleetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </StackPanel>


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10">
                <TabItem Header="Оптимизация по бюджету">
                    <StackPanel Margin="15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Image Source="/Resources/PNG/icon_aqua.png" Width="20" Height="20" Margin="0,2,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Доступный бюджет (аквамарин):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,20" FontSize="14"/>

                        <Button Content="РАССЧИТАТЬ ПО БЮДЖЕТУ" 
                                Command="{Binding CalculateByBudgetCommand}" 
                                Height="40" FontSize="14" FontWeight="Bold"/>

                        <Border Margin="0,20,0,0" Padding="15" CornerRadius="5" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BudgetResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="ИТОГИ РАСПРЕДЕЛЕНИЯ БЮДЖЕТА" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                <TextBlock FontSize="15" Margin="0,0,0,5">
                                    <Run Text="Потрачено аквамарина: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.TotalSpent}" FontWeight="Bold" Foreground="#F87171"/>
                                    <Run Text=" акв."/>
                                </TextBlock>
                                <TextBlock FontSize="15" Margin="0,0,0,5">
                                    <Run Text="Остаток бюджета: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.RemainingBudget}" FontWeight="Bold"/>
                                    <Run Text=" акв."/>
                                </TextBlock>
                                <TextBlock FontSize="15">
                                    <Run Text="Максимальный прирост очков: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BudgetResult.TotalPointsGained}" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Достижение цели">
                    <StackPanel Margin="15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Image Source="/Resources/PNG/icon_cargo.png" Width="20" Height="20" Margin="0,2,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Целевые грузовые очки:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding TargetPoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,20" FontSize="14"/>

                        <Button Content="РАССЧИТАТЬ ДЛЯ ЦЕЛИ" 
                                Command="{Binding CalculateByTargetCommand}" 
                                Height="40" FontSize="14" FontWeight="Bold"/>

                        <Border Margin="0,20,0,0" Padding="15" CornerRadius="5" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetResult}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="ИТОГИ ДОСТИЖЕНИЯ ЦЕЛИ" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Необходимо аквамарина: " FontWeight="Bold"/>
                                    <Run Text="{Binding TargetResult.TotalSpent}" FontWeight="Bold" FontSize="20" Foreground="#F87171"/>
                                    <Run Text=" акв." FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="15">
                                    <Run Text="Итоговый прирост очков: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding TargetResult.TotalPointsGained}" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Справочник">
                    <Grid Margin="15">
                        <DataGrid ItemsSource="{Binding ShipReferences}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Level}" Width="1.5*">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/PNG/icon_level.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="Уровень" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding UpgradeCost}" Width="1.5*">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/PNG/icon_aqua.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="Стоимость" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding PointsDelta}" Width="1.5*">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/PNG/icon_cargo.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="Прирост" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding PricePerPoint, StringFormat={}{0:F2}}" Width="1.5*">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/PNG/icon_aqua.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="Цена за 1 очко" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="О программе">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="550">
                        <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="800">

                            <StackPanel.Resources>
                                <Style TargetType="Hyperlink">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#4ADE80"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="BulletPointStyle" TargetType="TextBlock">
                                    <Setter Property="Text" Value="•"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                            </StackPanel.Resources>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Image Grid.Column="0" Source="/Resources/PNG/icon_logo.png" Width="240" Height="240" Margin="0,0,30,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="E4K Fleet Optimizer" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text="v.1.0.0" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,15"/>

                                    <Border BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Background="{DynamicResource SecondaryBackgroundBrush}" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="Разработчик: Нильфгаардец" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBlock Text="Сервер: RU1" FontSize="14" Margin="0,0,0,3"/>
                                            <TextBlock Text="Координаты: X: 325, Y: 402" FontSize="14"/>
                                        </StackPanel>
                                    </Border>

                                    <GroupBox Header="Связь и код" BorderBrush="{DynamicResource SecondaryTextBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
                                        <StackPanel Margin="10,10,10,5">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource BulletPointStyle}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="ivan.tokar.git@gmail.com" FontSize="15" Padding="0,0,5,0" Foreground="{DynamicResource PrimaryTextBrush}" Background="Transparent" BorderThickness="0" IsReadOnly="True" VerticalAlignment="Center"/>

                                                <Button Grid.Column="1" Click="CopyEmail_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,2" VerticalAlignment="Bottom" Grid.ColumnSpan="2" Margin="180,3,0,2">
                                                    <Button.ToolTip>
                                                        <ToolTip Content="Скопировать почту" 
                                                                 Placement="Top"
                                                                 Foreground="{DynamicResource PrimaryTextBrush}" 
                                                                 Background="{DynamicResource SecondaryBackgroundBrush}" 
                                                                 BorderBrush="{DynamicResource SecondaryTextBrush}" />
                                                    </Button.ToolTip>
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </Button>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource BulletPointStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" FontSize="15" VerticalAlignment="Center">
                                                    <Hyperlink NavigateUri="https://github.com/Tokar08/E4KFleetOptimizer" RequestNavigate="Hyperlink_RequestNavigate">
                                                        Исходный код на GitHub
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </Grid>

                            <GroupBox Header="О проекте" BorderBrush="{DynamicResource SecondaryTextBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,15">
                                <StackPanel Margin="10">
                                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                        <Run Text="E4K Fleet Optimizer" FontWeight="Bold"/> — это бесплатная утилита с открытым исходным кодом. Помогает рассчитать самое выгодное распределение аквамарина при прокачке кораблей, чтобы выжать максимум грузовых очков с минимальными затратами.
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="В планах" BorderBrush="{DynamicResource SecondaryTextBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,15">
                                <StackPanel Margin="10">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BulletPointStyle}"/>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                            <Run Text="Веб-версия:" FontWeight="SemiBold"/> Если утилита окажется полезной и будет отклик, перенесем функционал на полноценный сайт.
                                        </TextBlock>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BulletPointStyle}"/>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                            <Run Text="База координат:" FontWeight="SemiBold"/> Интеграция базы координат аквамариновых островов с фильтрацией по уровням (на стадии концепта).
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <ToggleButton Grid.Row="0" 
              IsChecked="{Binding IsDarkTheme}"
              HorizontalAlignment="Right" 
              VerticalAlignment="Top" 
              Margin="0,2,10,0"
              Background="Transparent"
              BorderThickness="0"
              Cursor="Hand">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons" Foreground="#FFFF57" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="5">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons" Foreground="#576DFF" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" 
                       Foreground="#F87171" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <GroupBox Grid.Row="2" Header="Детализация улучшений" Margin="0,5,0,0">
                <GroupBox.Style>
                    <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveResult}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <ItemsControl ItemsSource="{Binding ActiveResult.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                                    <Run Text="{Binding ShipsCount}"/>
                                                    <Run Text=" шт. | Ур. "/>
                                                    <Run Text="{Binding FromLevel}"/>
                                                    <Run Text=" ➔ "/>
                                                    <Run Text="{Binding ToLevel}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                                                    <Run Text="Прирост грузовых очков: "/>
                                                    <Run Text="{Binding TotalPointsGained}" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#F87171">
                                                <Run Text="- "/>
                                                <Run Text="{Binding TotalCost}"/>
                                                <Run Text=" акв."/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</Window>